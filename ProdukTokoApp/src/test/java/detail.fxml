<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DetailController"
            stylesheets="@styles/app.css">

    <top>

        <HBox styleClass="header" spacing="16">

            <Label text="Detail Produk"
                   styleClass="title"/>

            <Button text="Kembali ke Daftar"
                    onAction="#bukaDaftar"/>

        </HBox>

    </top>

    <center>

        <VBox styleClass="page" spacing="16">

            <VBox styleClass="card" spacing="12">

                <Label text="Kode Produk"
                       styleClass="muted"/>

                <Label fx:id="kodeLabel"
                       styleClass="subtitle"/>

                <Label text="Nama Produk"
                       styleClass="muted"/>

                <Label fx:id="namaLabel"
                       wrapText="true"/>

                <Label text="Kategori"
                       styleClass="muted"/>

                <Label fx:id="kategoriLabel"/>

                <Label text="Harga Produk"
                       styleClass="muted"/>

                <Label fx:id="hargaLabel"
                       styleClass="title"/>

                <Label fx:id="pesanLabel"
                       wrapText="true"/>

                <Button text="Tambah Produk Lain"
                        onAction="#tambahLagi"
                        styleClass="button-primary"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>